missao cheio fat(cheio n){
    se (n <= 1){
        volta 1;
    }

    volta n * fat(n - 1);
}

pprt("Digite um número: ");
cheio num = mandaopapo();
cheio resultado = fat(num);
pprt(resultado);


missao cheio fibonacci(cheio fib){
    cheio a = 0;
    cheio b = 1;

    pprt("Sequencia de Fibonacci");
    
    peao(cheio i = 0; i < fib; i++){
        pprt(a);

        cheio proximo = a + b;
        a = b;
        b = proximo;
    }

    volta a;
}

fibonacci(10);

